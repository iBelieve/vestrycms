{
  "name": "vestry",
  "version": "0.1.0",
  "description": "A git-backed CMS for Astro. Content, assets and configuration live in your repository; the control panel runs as an Astro integration.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "git",
    "github",
    "mdx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./pages/admin.astro": "./src/pages/admin.astro",
    "./pages/api.ts": "./src/pages/api.ts",
    "./ui": "./src/ui/main.tsx",
    "./core": "./src/core/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx/esm test/github-mock.ts && node --import tsx/esm test/auth.ts && node --import tsx/esm test/github-app.ts",
    "test:roundtrip": "node --import tsx/esm test/roundtrip.ts"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0",
    "prettier": "^3.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.0",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-subscript": "^3.20.0",
    "@tiptap/extension-superscript": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extensions": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@uiw/react-codemirror": "^4.25.0",
    "astring": "^1.9.0",
    "better-auth": "1.7.15",
    "estree-util-value-to-estree": "^3.5.0",
    "lucide-react": "^0.560.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/unist": "^3.0.3",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "vite": "^8.1.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  }
}
