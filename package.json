{
  "name": "vestrycms",
  "version": "0.8.0",
  "description": "A git-backed CMS for Astro. Content, assets and configuration live in your repository; the control panel runs as an Astro integration.",
  "license": "MIT",
  "author": "Michael Spencer",
  "homepage": "https://github.com/iBelieve/vestrycms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBelieve/vestrycms.git"
  },
  "bugs": {
    "url": "https://github.com/iBelieve/vestrycms/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "git",
    "github",
    "mdx",
    "cloudflare",
    "withastro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx/index.d.ts",
      "default": "./dist/mdx/index.js"
    },
    "./forms": {
      "types": "./dist/core/submissions.d.ts",
      "default": "./dist/core/submissions.js"
    },
    "./pages/admin.astro": "./dist/pages/admin.astro",
    "./pages/api": {
      "types": "./dist/pages/api.d.ts",
      "default": "./dist/pages/api.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:roundtrip": "node --import tsx/esm test/manual/roundtrip.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "fallow": "fallow dead-code",
    "health": "fallow health --complexity --coverage coverage",
    "prepack": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0",
    "prettier": "^3.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.0",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-subscript": "^3.20.0",
    "@tiptap/extension-superscript": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extensions": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@uiw/react-codemirror": "^4.25.0",
    "better-auth": "1.7.23",
    "lucide-react": "^1.69.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-mdx-jsx": "^3.2.1",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.5.1",
    "yaml": "^2.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/estree": "^1.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "astro": "^7.4.3",
    "fallow": "^3.41.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
