---
/// <reference path="../env.d.ts" />
// The live preview route: renders the unsaved entry the preview window
// posts with the collection's preview component, its body drawn with the
// site's components.
import PreviewParts from "./PreviewParts.astro";
import { openPreview } from "./preview-route.js";

export const prerender = false;

const opened = await openPreview(Astro.request);
if (opened instanceof Response) return opened;
const { entry, body, components } = opened;
const Preview = opened.Preview as any;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<Preview entry={entry}>
  <PreviewParts parts={body} components={components} />
</Preview>
